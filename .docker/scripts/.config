# ROS2 Jazzy Jalisco
CONTAINER_NAME="ros2_dev_lab"
IMAGE_NAME="ubuntu_desktop-ros2"
COMPOSE_SUBDIR=".docker/ubuntu_desktop"

# Edge (Generic Board)
EDGE_CONTAINER_NAME="ros2_edge"
EDGE_IMAGE_NAME="ubuntu_edge-ros2"
EDGE_COMPOSE_SUBDIR=".docker/ubuntu_edge"

# Raspberry Pi
RPI_CONTAINER_NAME="ros2_rpi"
RPI_IMAGE_NAME="ubuntu_rpi-ros2"
RPI_COMPOSE_SUBDIR=".docker/ubuntu_rpi"

# Arduino Uno
UNO_Q_CONTAINER_NAME="ros2_uno_q"
UNO_Q_IMAGE_NAME="ubuntu_uno_q-ros2"
UNO_Q_COMPOSE_SUBDIR=".docker/ubuntu_uno_q"

# ESP32 / ESP-IDF 5.4 (firmware micro-ROS)
ESP_CONTAINER_NAME="esp32_dev_lab"
ESP_IMAGE_NAME="esp32-idf"
ESP_COMPOSE_SUBDIR=".docker/esp32"