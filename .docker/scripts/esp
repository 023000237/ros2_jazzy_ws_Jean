#!/usr/bin/env bash

set -e

# Script & Project directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Load config (same directory)
CONFIG_FILE="$SCRIPT_DIR/.config"
if [ ! -f "$CONFIG_FILE" ]; then
    echo "ERROR: Missing config file: $CONFIG_FILE"
    exit 1
fi
source "$CONFIG_FILE"

# Docker-compose directory
COMPOSE_DIR="$PROJECT_ROOT/$ESP_COMPOSE_SUBDIR"

cd "$COMPOSE_DIR"

# Build image only the first time
IMAGE_ID=$(docker images -q ${ESP_IMAGE_NAME} 2>/dev/null || true)

if [ -z "$IMAGE_ID" ]; then
    echo "ESP-IDF image not found. Building container..."
    docker compose build
fi

# Container lifecycle handling
if docker ps --format '{{.Names}}' | grep -q "^${ESP_CONTAINER_NAME}$"; then
    echo "Container already running."
elif docker ps -a --format '{{.Names}}' | grep -q "^${ESP_CONTAINER_NAME}$"; then
    echo "Starting existing container..."
    docker start ${ESP_CONTAINER_NAME}
else
    echo "Creating and starting container..."
    docker compose up -d
fi

# Enter ESP-IDF environment
echo "Opening ESP-IDF development shell..."

docker exec -it ${ESP_CONTAINER_NAME} bash -c "
source /opt/esp/idf/export.sh
exec bash
"
