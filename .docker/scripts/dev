#!/usr/bin/env bash

set -e

# Script & Project directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Load config (same directory)
CONFIG_FILE="$SCRIPT_DIR/.config"
if [ ! -f "$CONFIG_FILE" ]; then
    echo "ERROR: Missing config file: $CONFIG_FILE"
    exit 1
fi
source "$CONFIG_FILE"

# Docker-compose directory
COMPOSE_DIR="$PROJECT_ROOT/$COMPOSE_SUBDIR"

cd "$COMPOSE_DIR"

# Build image only the first time
IMAGE_ID=$(docker images -q ${IMAGE_NAME} 2>/dev/null || true)

if [ -z "$IMAGE_ID" ]; then
    echo "ROS2 image not found. Building container..."
    docker compose build
fi

# Container lifecycle handling
if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo "Container already running."
elif docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo "Starting existing container..."
    docker start ${CONTAINER_NAME}
else
    echo "Creating and starting container..."
    docker compose up -d
fi

# Enter ROS2 environment
echo "Opening ROS2 development shell..."

docker exec -it ${CONTAINER_NAME} bash -c "
source /opt/ros/jazzy/setup.bash
[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash
exec bash
"